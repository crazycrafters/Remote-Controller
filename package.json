{
  "name": "remote-controller-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm start --workspace=@remote-controller/agent",
    "device": "npm start --workspace=@remote-controller/agent",
    "management": "npm start --workspace=@remote-controller/server",
    "test": "npm run test --workspaces && npm run test:integration",
    "test:integration": "node --test test/management.test.js test/bootstrap.test.js",
    "check": "npm run check --workspaces",
    "dev:server": "npm run dev --workspace=@remote-controller/server",
    "dev:agent": "npm run dev --workspace=@remote-controller/agent"
  },
  "workspaces": [
    "agent",
    "server"
  ]
}
