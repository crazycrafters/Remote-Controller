# Copy to .env in agent/. HTTPS is required for a server on another computer.
RC_SERVER_URL=http://127.0.0.1:4320
RC_FILE_MODE=system
# Exact application names that administrators may close (Windows: no .exe suffix).
RC_ALLOWED_APPS=
# Optional: absolute persistent identity directory.
# RC_DEVICE_DATA=C:/RemoteControllerData
